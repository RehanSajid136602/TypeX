{
  "name": "typex-monorepo",
  "version": "0.3.1",
  "private": true,
  "description": "TypeX \u2014 High-Performance Minimalist Typing Engine & Live Stage Competition Platform",
  "scripts": {
    "dev": "./start.sh",
    "build:frontend": "cd frontend && pnpm exec next build",
    "build:backend": "g++ -std=c++17 -O3 -pthread backend/main.cpp backend/sqlite3.o -Ibackend/include -ldl -o backend/typex_server",
    "build:shell": "g++ -std=c++17 -O3 desktop_shell/main.cpp -o desktop_shell/typex-app",
    "build:deb": "./scripts/build_deb.sh",
    "package": "./scripts/build_deb.sh"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
